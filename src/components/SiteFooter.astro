---
import { footerSections } from '../content/es';
import Icon from './Icon.astro';

interface Props {
  showLead?: boolean;
}

const { showLead = true } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    {showLead && (
      <div class="footer-lead">
        <div>
          <p class="overline gold">EMPRESAS QUE EVALÚAN INGRESAR AL PERÚ</p>
          <h2>¿Tu empresa evalúa<br /><em>ingresar al Perú?</em></h2>
        </div>
        <a class="btn btn-gold" href="/contacto.html?tipo=expansion"><span>Conversemos sobre expansión</span><Icon name="arrow-right" /></a>
      </div>
    )}
    <div class="footer-columns">
      <div class="footer-company">
        <div class="footer-brand">
          <img src="/brand/emblem-dark-transparent.png" alt="" aria-hidden="true" width="64" height="64" />
          <span>POWERFUL</span>
        </div>
        <p>Inversiones y Representación Empresarial</p>
        <p class="footer-note">Representación y articulación empresarial en el Perú. Alcance nacional, con mayor presencia de nuestra red en el norte y nororiente.</p>
      </div>
      {footerSections.map((section) => (
        <div>
          <span class="footer-heading">{section.heading}</span>
          {section.links.map((link) => <a href={link.href}>{link.label}</a>)}
          {section.heading === 'INFORMACIÓN' && <span class="footer-geography">PERÚ · ALCANCE NACIONAL</span>}
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© <span id="year">2026</span> POWERFUL. Prototipo corporativo para validación.</span>
      <span>Versión demostrativa — Información sujeta a aprobación</span>
      <a href="#top">Volver arriba ↑</a>
    </div>
  </div>
</footer>

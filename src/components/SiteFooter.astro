---
import type { SiteShellContent } from '../content/types';
import Icon from './Icon.astro';

interface Props {
  showLead?: boolean;
  content: SiteShellContent['footer'];
}

const { showLead = true, content } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    {showLead && (
      <div class="footer-lead">
        <div>
          <p class="overline gold">{content.lead.eyebrow}</p>
          <h2>{content.lead.heading.lead}<br /><em>{content.lead.heading.emphasis}</em></h2>
        </div>
        <a class="btn btn-gold" href={content.lead.actionHref}><span>{content.lead.actionLabel}</span><Icon name="arrow-right" /></a>
      </div>
    )}
    <div class="footer-columns">
      <div class="footer-company">
        <div class="footer-brand">
          <img src="/brand/emblem-dark-transparent-registered.png" alt="" aria-hidden="true" width="64" height="64" />
          <span>POWERFUL</span>
        </div>
        <p>{content.companyDescription}</p>
        <p class="footer-note">{content.companyNote}</p>
      </div>
      {content.sections.map((section) => (
        <div>
          <span class="footer-heading">{section.heading}</span>
          {section.links.map((link) => <a href={link.href} hreflang={link.hreflang}>{link.label}</a>)}
          {section.footerNote && <span class="footer-geography">{section.footerNote}</span>}
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>© <span id="year">2026</span> POWERFUL.</span>
      <a href="#top">{content.backToTopLabel} ↑</a>
    </div>
  </div>
</footer>

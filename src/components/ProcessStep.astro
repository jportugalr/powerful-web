---
import Icon from './Icon.astro';
import type { ProcessStep } from '../content/types';

interface Props {
  step: ProcessStep;
}

const { step } = Astro.props;
---

<article class="step">
  <span class="step-num">{step.number}</span>
  <h3>{step.title}</h3>
  <p>{step.description}</p>
  <span class="step-end"><Icon name="arrow-up-right" /></span>
</article>

---
import type { SubpageHeroEs } from '../content/es';
import Icon from './Icon.astro';

interface Props {
  content: SubpageHeroEs;
  action?: { label: string; href: string };
  variant?: 'default' | 'process';
}

const { content, action, variant = 'default' } = Astro.props;
---

<section class:list={['page-hero', 'sub', { 'page-hero-process': variant === 'process' }]}>
  <div class="container page-hero-inner">
    <div class="page-hero-copy">
      <p class="overline">{content.eyebrow}</p>
      <h1>{content.heading.lead}{' '}<em>{content.heading.emphasis}</em></h1>
      <p class="lede">{content.lede}</p>
      {action && (
        <a class="btn btn-gold" href={action.href}>
          <span>{action.label}</span>
          <Icon name="arrow-right" />
        </a>
      )}
    </div>
    {content.pageNumber && (
      <div class="page-hero-no" aria-hidden="true">
        <span>POWERFUL / PERÚ</span>
        <b>{content.pageNumber}</b>
      </div>
    )}
  </div>
</section>

---
import type { businessPagesEs } from '../content/es';

interface Props {
  content: typeof businessPagesEs.comoTrabajamos;
}

const { content } = Astro.props;
const fields = [
  { id: 'objetivos', label: 'Objetivos', role: 'Qué busca cada parte' },
  { id: 'roles', label: 'Roles', role: 'Qué función cumple' },
  { id: 'responsabilidades', label: 'Responsabilidades', role: 'Qué asume cada parte' },
  { id: 'acuerdos', label: 'Acuerdos', role: 'Qué alcance se define' },
  { id: 'colaboracion', label: 'Colaboración', role: 'Cómo participan las partes' },
];
---

<section class="framework" data-collaboration-framework aria-labelledby="framework-title">
  <div class="container framework-layout">
    <header class="framework-intro">
      <h1 id="framework-title">{content.hero.heading.lead}<br /><em>{content.hero.heading.emphasis}</em></h1>
      <p class="framework-lede">{content.hero.lede}</p>
      <a class="framework-read" href="#principios">
        Explorar los principios
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 4v16m-6-6 6 6 6-6" />
        </svg>
      </a>
    </header>

    <figure class="framework-figure" aria-labelledby="framework-document-title">
      <div class="framework-document" data-framework-document>
        <svg class="framework-outline" viewBox="0 0 600 700" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path data-framework-stroke pathLength="1" d="M300 16H584V684H16V16H300" />
        </svg>
        <div class="framework-document-heading">
          <h2 id="framework-document-title">Marco de<br /><span>colaboración.</span></h2>
        </div>

        <nav class="framework-fields" aria-label="Explorar los cinco principios">
          {fields.map((field) => (
            <a class="framework-field" href={`#principio-${field.id}`} data-framework-field={field.id}>
              <span class="framework-field-name">{field.label}</span>
              <span class="framework-field-role">{field.role}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          ))}
        </nav>

        <div class="framework-document-footer">
          <span>POWERFUL <span aria-hidden="true">/</span> PERÚ</span>
          <span>Cinco principios, un marco común.</span>
        </div>
      </div>
      <figcaption class="framework-caption">
        <span>Selecciona un campo para explorar su función.</span>
        <button class="framework-replay" type="button" data-framework-replay hidden>
          Ver conjunto
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 10a8 8 0 1 1 1 7M4 4v6h6" />
          </svg>
        </button>
      </figcaption>
    </figure>

    <div class="framework-reading" id="principios">
      <div class="framework-reading-intro">
        <h2>{content.process.heading.lead}{' '}<em>{content.process.heading.emphasis}</em></h2>
        <p>{content.process.description}</p>
      </div>
      {content.process.steps.map((step, index) => (
        <article class="framework-principle" id={`principio-${fields[index].id}`} data-framework-principle={fields[index].id}>
          <div class="framework-principle-line" aria-hidden="true"></div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
          <span class="framework-principle-role">{fields[index].role}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .framework {
    background: var(--ivory);
    padding-block: clamp(54px, 6vw, 94px) 100px;
    overflow: clip;
    --framework-ink: #14263d;
    --framework-secondary: #506176;
  }

  .framework ::selection {
    color: var(--navy2);
    background: var(--gold-light);
  }

  .framework-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    column-gap: clamp(40px, 6.5vw, 94px);
    align-items: start;
    position: relative;
  }

  .framework-intro {
    grid-column: 1;
    padding-block: clamp(12px, 3vw, 46px) 0;
  }

  .framework h1,
  .framework h2,
  .framework h3 {
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .framework h1 {
    font-size: clamp(48px, 5.35vw, 76px);
    font-weight: 620;
    line-height: 1.03;
    margin-bottom: 30px;
    color: var(--framework-ink);
  }

  .framework-intro h1 em {
    color: #85652f;
  }

  .framework-lede {
    font-size: clamp(17px, 1.55vw, 20px);
    line-height: 1.75;
    max-width: 36ch;
    color: var(--framework-secondary);
    margin-bottom: 32px;
  }

  .framework-read {
    display: inline-flex;
    gap: 18px;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    font-weight: 650;
    color: var(--framework-ink);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: #b79862;
  }

  .framework-read svg,
  .framework-field svg,
  .framework-replay svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    flex: none;
  }

  .framework-figure {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: sticky;
    top: 116px;
    margin: 0;
    min-width: 0;
  }

  .framework-document {
    position: relative;
    isolation: isolate;
    padding: clamp(32px, 3.6vw, 50px) clamp(26px, 3.1vw, 44px) 30px;
    color: var(--ivory);
    background: var(--navy);
    box-shadow: 0 28px 54px -30px rgb(12 29 49 / 45%);
  }

  .framework-outline {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 1;
    pointer-events: none;
  }

  .framework-outline path {
    vector-effect: non-scaling-stroke;
  }

  .framework-document-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  .framework-document-heading h2 {
    font-size: clamp(28px, 2.9vw, 41px);
    line-height: 1.12;
    font-weight: 550;
    margin: 0;
  }

  .framework-document-heading h2 span {
    color: var(--gold-light);
  }

  .framework-fields {
    border-bottom: 1px solid #556271;
  }

  .framework-field {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16px;
    align-content: center;
    gap: 3px 12px;
    min-height: 77px;
    padding: 13px 14px;
    margin-inline: -14px;
    border-top: 1px solid #556271;
    background: var(--navy);
    transition: background-color 180ms ease, color 180ms ease;
  }

  .framework-field-name {
    font-size: clamp(16px, 1.65vw, 21px);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .framework-field-role {
    color: #c2cbd3;
    font-size: 12px;
    line-height: 1.5;
  }

  .framework-field svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    width: 16px;
    color: var(--gold-light);
  }

  .framework-field:hover,
  .framework-field:focus-visible {
    background: #243b52;
  }

  .framework-field[aria-current='true'] {
    background: var(--gold-light);
    color: var(--navy2);
  }

  .framework-field[aria-current='true'] .framework-field-role,
  .framework-field[aria-current='true'] svg {
    color: #293d51;
  }

  .framework-field:focus-visible,
  .framework-replay:focus-visible,
  .framework-read:focus-visible {
    outline: 2px solid #9b762e;
    outline-offset: 5px;
  }

  .framework-field:focus-visible {
    outline-color: var(--gold-light);
    outline-offset: -3px;
  }

  .framework-document-footer {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    font-size: 10px;
    color: #bcc7d1;
    line-height: 1.6;
  }

  .framework-document-footer > span:first-child {
    white-space: nowrap;
    letter-spacing: 0.08em;
    color: var(--gold-light);
  }

  .framework-document-footer > span:last-child {
    text-align: right;
    max-width: 19ch;
  }

  .framework-caption {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 16px;
    padding-top: 19px;
    color: var(--framework-secondary);
    font-size: 11px;
    line-height: 1.6;
  }

  .framework-caption > span {
    max-width: 25ch;
  }

  .framework-replay {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--navy);
    background: transparent;
    border: 0;
    padding: 0 0 6px;
    min-height: 32px;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 650;
    border-bottom: 1px solid #a58b60;
  }

  .framework-replay[hidden] {
    display: none;
  }

  .framework-replay:hover {
    color: #76551f;
  }

  .framework-replay[aria-busy='true'] svg {
    color: #85652f;
  }

  .framework-reading {
    grid-column: 1;
    padding-top: clamp(110px, 13vw, 185px);
  }

  .framework-reading-intro {
    margin-bottom: 70px;
  }

  .framework-reading-intro h2 {
    font-size: clamp(32px, 3.25vw, 46px);
    line-height: 1.13;
    font-weight: 600;
    margin-bottom: 22px;
  }

  .framework-reading-intro h2 em {
    color: #85652f;
  }

  .framework-reading-intro p,
  .framework-principle p {
    color: var(--framework-secondary);
    font-size: 16px;
    line-height: 1.8;
    max-width: 42ch;
  }

  .framework-principle {
    scroll-margin-top: 155px;
    padding-block: 0 70px;
    position: relative;
  }

  .framework-principle-line {
    height: 1px;
    background: #c9c7bf;
    margin-bottom: 32px;
    position: relative;
  }

  .framework-principle-line::after {
    content: '';
    display: block;
    width: 42px;
    height: 1px;
    background: #85652f;
    position: absolute;
    inset: 0 auto auto 0;
    transition: width 220ms ease;
  }

  .framework-principle[data-current='true'] .framework-principle-line::after,
  .framework-principle:target .framework-principle-line::after {
    width: 100%;
  }

  .framework-principle h3 {
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 560;
    margin-bottom: 17px;
  }

  .framework-principle p {
    margin-bottom: 18px;
  }

  .framework-principle-role {
    display: inline-block;
    color: #76551f;
    font-size: 11px;
    font-weight: 650;
    line-height: 1.5;
  }

  .framework-principle:last-child {
    padding-bottom: 0;
  }

  @media (min-width: 1001px) and (max-height: 820px) {
    .framework-figure {
      top: 98px;
    }

    .framework-document {
      padding-top: 30px;
      padding-bottom: 24px;
    }

    .framework-document-heading {
      margin-bottom: 22px;
    }

    .framework-field {
      min-height: 67px;
      padding-block: 10px;
    }
  }

  @media (max-width: 1000px) {
    .framework-layout {
      column-gap: 34px;
    }

    .framework-figure {
      top: 96px;
    }

    .framework-document {
      padding: 30px 24px 25px;
    }

    .framework-document-heading {
      gap: 12px;
      margin-bottom: 24px;
    }

    .framework-document-heading h2 {
      font-size: 28px;
    }

    .framework-field {
      margin-inline: -8px;
      padding-inline: 8px;
      min-height: 72px;
    }

    .framework-document-footer {
      display: block;
    }

    .framework-document-footer > span:last-child {
      display: block;
      max-width: none;
      text-align: left;
      margin-top: 5px;
    }

    .framework-caption {
      flex-wrap: wrap;
      gap: 10px;
    }
  }

  @media (max-width: 760px) {
    .framework {
      padding-block: 48px 68px;
    }

    .framework-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .framework-intro {
      padding: 0;
    }

    .framework h1 {
      font-size: clamp(45px, 8vw, 60px);
      max-width: 12ch;
      margin-bottom: 24px;
    }

    .framework-lede {
      font-size: 17px;
      max-width: 40ch;
      margin-bottom: 19px;
    }

    .framework-figure {
      position: relative;
      grid-column: 1;
      grid-row: 2;
      top: auto;
      margin-top: 38px;
    }

    .framework-document {
      padding: 30px 26px 24px;
    }

    .framework-document-heading h2 {
      font-size: clamp(28px, 6.2vw, 38px);
    }

    .framework-field {
      min-height: 70px;
      margin-inline: -10px;
      padding-inline: 10px;
    }

    .framework-field-name {
      font-size: 18px;
    }

    .framework-document-footer {
      display: flex;
    }

    .framework-document-footer > span:last-child {
      max-width: 19ch;
      text-align: right;
      margin-top: 0;
    }

    .framework-caption {
      flex-wrap: nowrap;
    }

    .framework-reading {
      padding-top: 80px;
    }

    .framework-reading-intro {
      margin-bottom: 44px;
    }

    .framework-reading-intro h2 {
      max-width: 15ch;
      font-size: 38px;
    }

    .framework-principle {
      padding-bottom: 50px;
      scroll-margin-top: 110px;
    }

    .framework-principle h3 {
      font-size: 29px;
    }

    .framework-principle-line {
      margin-bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .framework-principle-line::after {
      transition: none;
    }
  }
</style>

---
import type { businessPagesEs } from '../content/es';

interface Props {
  content: typeof businessPagesEs.comoTrabajamos;
}

const { content } = Astro.props;
const principleIds = ['objetivos', 'roles', 'responsabilidades', 'acuerdos', 'colaboracion'];
---

<section class="framework" data-collaboration-framework aria-labelledby="framework-title">
  <header class="framework-intro">
    <div class="container framework-intro-layout">
      <h1 id="framework-title">{content.hero.heading.lead}<br /><em>{content.hero.heading.emphasis}</em></h1>
      <p>{content.hero.lede}</p>
    </div>
  </header>

  <div class="container framework-content">
    <div class="framework-heading">
      <h2 id="principios">{content.process.heading.lead}{' '}<em>{content.process.heading.emphasis}</em></h2>
      <p>{content.process.description}</p>
    </div>

    <div class="framework-principles" data-framework-principles aria-labelledby="principios">
      <svg class="framework-bracket" viewBox="0 0 32 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path data-framework-stroke pathLength="1" d="M28 12H4V988H28" />
      </svg>
      {content.process.steps.map((step, index) => (
        <article class="framework-principle" id={`principio-${principleIds[index]}`} data-framework-principle>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .framework {
    background: var(--paper);
    color: var(--navy);
    overflow: clip;
    --framework-secondary: #506176;
    --framework-gold: #85652f;
  }

  .framework ::selection {
    color: var(--navy2);
    background: var(--gold-light);
  }

  .framework h1,
  .framework h2,
  .framework h3 {
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .framework-intro {
    background: var(--ivory);
    padding-block: clamp(54px, 6vw, 88px);
  }

  .framework-intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: end;
    gap: clamp(40px, 7vw, 100px);
  }

  .framework h1 {
    font-size: clamp(44px, 5vw, 68px);
    font-weight: 620;
    line-height: 1.06;
    margin: 0;
  }

  .framework h1 em,
  .framework-heading h2 em {
    color: var(--framework-gold);
  }

  .framework-intro p {
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.8;
    max-width: 40ch;
    margin: 0 0 4px;
    color: var(--framework-secondary);
  }

  .framework-content {
    padding-block: clamp(52px, 6vw, 82px) clamp(70px, 8vw, 110px);
  }

  .framework-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: end;
    gap: clamp(40px, 7vw, 100px);
    margin-bottom: 50px;
  }

  .framework-heading h2 {
    font-size: clamp(32px, 3.25vw, 44px);
    line-height: 1.14;
    font-weight: 580;
    max-width: 18ch;
    margin: 0;
  }

  .framework-heading p,
  .framework-principle p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--framework-secondary);
    margin: 0;
  }

  .framework-heading p {
    max-width: 44ch;
  }

  .framework-principles {
    position: relative;
    padding-left: 60px;
  }

  .framework-bracket {
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 100%;
    fill: none;
    stroke: var(--gold);
    stroke-width: 1;
    pointer-events: none;
  }

  .framework-bracket path {
    vector-effect: non-scaling-stroke;
  }

  .framework-principle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(36px, 6vw, 86px);
    align-items: baseline;
    padding-block: 32px;
    scroll-margin-top: 130px;
  }

  .framework-principle + .framework-principle {
    border-top: 1px solid #dde0df;
  }

  .framework-principle h3 {
    font-size: clamp(24px, 2.4vw, 31px);
    font-weight: 560;
    line-height: 1.18;
    margin: 0;
    transition: color 180ms ease;
  }

  .framework-principle[data-reading] h3 {
    color: var(--framework-gold);
  }

  .framework-principle p {
    max-width: 52ch;
  }

  @media (max-width: 1000px) {
    .framework-intro-layout,
    .framework-heading {
      gap: 38px;
    }

    .framework-principles {
      padding-left: 48px;
    }

    .framework-principle {
      gap: 34px;
    }
  }

  @media (max-width: 760px) {
    .framework-intro {
      padding-block: 46px 42px;
    }

    .framework-intro-layout,
    .framework-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .framework h1 {
      font-size: clamp(42px, 8vw, 58px);
    }

    .framework-intro p {
      font-size: 17px;
      max-width: 46ch;
      margin: 0;
    }

    .framework-content {
      padding-block: 48px 60px;
    }

    .framework-heading {
      margin-bottom: 30px;
      gap: 20px;
    }

    .framework-heading h2 {
      font-size: 34px;
    }

    .framework-principles {
      padding-left: 30px;
    }

    .framework-bracket {
      width: 18px;
    }

    .framework-principle {
      grid-template-columns: minmax(0, 1fr);
      gap: 13px;
      padding-block: 25px;
      scroll-margin-top: 110px;
    }

    .framework-principle h3 {
      font-size: 25px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .framework-principle h3 {
      transition: none;
    }
  }
</style>

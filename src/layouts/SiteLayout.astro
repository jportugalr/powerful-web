---
import '@fontsource-variable/inter';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  showFooterLead?: boolean;
  indexable?: boolean;
}

const { title, description, showFooterLead = true, indexable = false } = Astro.props;
const canonicalUrl = import.meta.env.PUBLIC_INDEXING_ENABLED === 'true' && indexable && Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#14263D" />
    <meta name="description" content={description} />
    <meta name="robots" content={canonicalUrl ? 'index,follow' : 'noindex,nofollow'} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:title" content={title} />}
    {canonicalUrl && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <SiteFooter showLead={showFooterLead} />
    <script>
      import '../scripts/navigation';
    </script>
  </body>
</html>

---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import ServiceDetailRow from '../components/ServiceDetailRow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { businessPagesEs } from '../content/es';

const page = businessPagesEs.servicios;
---

<SiteLayout title={page.metadata.title} description={page.metadata.description} indexable={true}>
  <PageHero content={page.hero} hideDecorativeNumber />

  <section class="section">
    <div class="container service-detail-list" data-service-rows>
      {
        page.details.map((item) => (
          <ServiceDetailRow item={item} />
        ))
      }
    </div>
  </section>

  <section class="section service-notice">
    <div class="container notice-panel">
      <div>
        <Icon name="shield-check" />
        <p class="overline">{page.notice.eyebrow}</p>
      </div>
      <h2>{page.notice.heading}</h2>
      <p>{page.notice.description}</p>
    </div>
  </section>
</SiteLayout>

<script>
  const list = document.querySelector<HTMLElement>('[data-service-rows]');
  const rows = list ? Array.from(list.querySelectorAll<HTMLElement>('.detail-row')) : [];
  const motionPreference = typeof window.matchMedia === 'function'
    ? window.matchMedia('(prefers-reduced-motion: reduce)')
    : null;

  if (list && rows.length && motionPreference && !motionPreference.matches && typeof IntersectionObserver !== 'undefined') {
    let observer: IntersectionObserver | undefined;

    const restoreStaticContent = () => {
      observer?.disconnect();
      list.removeAttribute('data-reveal-enabled');
      rows.forEach((row) => row.removeAttribute('data-reveal-state'));
    };

    try {
      observer = new IntersectionObserver((entries, activeObserver) => {
        entries.forEach((entry) => {
          const row = entry.target as HTMLElement;

          if (entry.isIntersecting) {
            row.dataset.revealState = 'visible';
            activeObserver.unobserve(row);
          } else {
            row.dataset.revealState = 'pending';
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

      list.dataset.revealEnabled = 'true';
      rows.forEach((row) => observer?.observe(row));
      motionPreference.addEventListener('change', (event) => {
        if (event.matches) restoreStaticContent();
      });
    } catch {
      restoreStaticContent();
    }
  }
</script>

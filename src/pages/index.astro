---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import { home } from '../content/es';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={home.description} />
    <meta name="theme-color" content="#F4F1EA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={home.title} />
    <meta property="og:description" content={home.description} />
    <meta property="og:type" content="website" />
    <title>{home.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <header class="site-header">
      <div class="header-inner container">
        <a href="#inicio" class="brand" aria-label="POWERFUL, inicio">
          <img src="/brand/powerful-master.png" width="2048" height="683" alt="POWERFUL" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" hidden>
          <span class="menu-label">Menú</span>
          <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
        </button>
        <nav class="main-navigation" id="main-navigation" aria-label="Navegación principal">
          {home.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="nav-contact" href="#conversemos">Conversemos <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <section class="hero container" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Su contraparte empresarial <span>en Perú.</span></h1>
          <p>{home.hero.description}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#conversemos">{home.hero.primary}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
            <a class="text-link" href="#como-trabajamos">{home.hero.secondary}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>
          </div>
          <div class="hero-location"><span aria-hidden="true"></span>Perú, nuestro punto de encuentro.</div>
        </div>
        <figure class="hero-figure">
          <div class="hero-image-frame"><img class="hero-image" src="/images/miraflores-lima.webp" width="1500" height="1000" fetchpriority="high" alt="Costa y paisaje urbano de Miraflores en Lima, Perú" /></div>
          <figcaption>{home.hero.caption}</figcaption>
        </figure>
        <svg class="connection" viewBox="0 0 420 280" fill="none" aria-hidden="true"><path d="M14 249C100 249 46 40 172 40c119 0 88 169 178 169 24 0 39-15 54-33" /><circle cx="14" cy="249" r="5"/><circle cx="404" cy="176" r="5"/></svg>
      </section>

      <section class="capabilities section container" id="que-hacemos" aria-labelledby="capabilities-title">
        <div class="section-intro">
          <h2 id="capabilities-title">{home.capabilities.title}</h2>
          <p>{home.capabilities.introduction}</p>
        </div>
        <div class="capability-list">
          {home.capabilities.items.map((item) => (
            <article class="capability">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="capability-detail">{item.detail}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="sectors section" id="sectores" aria-labelledby="sectors-title">
        <div class="container sectors-inner">
          <div class="sectors-intro">
            <h2 id="sectors-title">{home.sectors.title}</h2>
            <p>{home.sectors.description}</p>
            <p class="sector-note">{home.sectors.note}</p>
            <div class="compass" aria-hidden="true"><span>PERÚ</span><svg viewBox="0 0 240 160" fill="none"><path d="M20 140C20 65 75 20 120 20s100 45 100 120M60 140C60 65 100 20 120 20s60 45 60 120M120 20v120M21 110h198M40 65h160"/><circle cx="120" cy="110" r="6"/></svg></div>
          </div>
          <div class="sector-list">
            {home.sectors.items.map((item, index) => (
              <details class="sector" open={index === 0}>
                <summary>{item.title}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7v14" /></svg></summary>
                <p>{item.description}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="process section container" id="como-trabajamos" aria-labelledby="process-title">
        <div class="section-intro">
          <h2 id="process-title">{home.process.title}</h2>
          <p>{home.process.description}</p>
        </div>
        <ol class="process-list">
          {home.process.steps.map((item, index) => (
            <li><span class="step-marker" aria-hidden="true">{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>
          ))}
        </ol>
      </section>

      <section class="firm section" id="la-firma" aria-labelledby="firm-title">
        <div class="container firm-inner">
          <h2 id="firm-title">{home.firm.title}</h2>
          <div class="firm-body"><p>{home.firm.description}</p><ul>{home.firm.principles.map((principle) => <li>{principle}</li>)}</ul></div>
          <p class="firm-statement">{home.firm.statement}</p>
        </div>
      </section>

      <section class="contact section container" id="conversemos" aria-labelledby="contact-title">
        <div class="contact-copy"><h2 id="contact-title">{home.contact.title}</h2><p>{home.contact.description}</p></div>
        <div class="contact-preparation">
          <p class="contact-notice" id="contact-notice">{home.contact.notice}</p>
          <form id="consultation-draft" aria-describedby="contact-notice" hidden>
            <div class="field"><label for="company">Empresa o iniciativa</label><input id="company" name="company" autocomplete="organization" maxlength="180" required /></div>
            <div class="field"><label for="interest">¿Qué necesita en Perú?</label><select id="interest" name="interest">{home.contact.needs.map((need) => <option>{need}</option>)}</select></div>
            <div class="field"><label for="objective">Su objetivo</label><textarea id="objective" name="objective" rows="3" maxlength="3000" placeholder="Qué busca desarrollar y en qué etapa se encuentra." required></textarea></div>
            <button class="button button-primary" type="submit">Descargar borrador<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4" /></svg></button>
            <p class="draft-status" id="draft-status" role="status" aria-live="polite"></p>
          </form>
          <noscript><p>Para preparar una consulta, reúna el nombre de su empresa, sus objetivos y el tipo de representación que necesita. Los canales de contacto se publicarán próximamente.</p></noscript>
        </div>
      </section>
    </main>
    <footer class="site-footer"><div class="container footer-inner"><a href="#inicio" class="brand footer-brand" aria-label="Volver al inicio POWERFUL"><img src="/brand/powerful-master.png" width="2048" height="683" alt="POWERFUL" loading="lazy" /></a><p>Representación empresarial.<br />Conexiones con propósito.</p><a class="text-link" href="#inicio">Volver al inicio<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V4m-6 6 6-6 6 6" /></svg></a><small>POWERFUL · Perú</small></div></footer>
    <script>import '../scripts/home';</script>
  </body>
</html>
